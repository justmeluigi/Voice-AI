  taskTranscribeBtn.addEventListener('click', () => setTaskMode('transcribe'));
  taskTranslateBtn.addEventListener('click', () => setTaskMode('translate'));

  function setTaskMode(mode) {
    currentTask = mode;
    if (mode === 'transcribe') {
      taskTranscribeBtn.className = 'flex items-center justify-center gap-2 py-2 px-3 rounded-xl text-xs font-semibold bg-indigo-600 text-white transition';
      taskTranslateBtn.className = 'flex items-center justify-center gap-2 py-2 px-3 rounded-xl text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-300 transition';
      taskDescription.textContent = 'Preserves spoken language as original text.';
    } else {
      taskTranslateBtn.className = 'flex items-center justify-center gap-2 py-2 px-3 rounded-xl text-xs font-semibold bg-indigo-600 text-white transition';
      taskTranscribeBtn.className = 'flex items-center justify-center gap-2 py-2 px-3 rounded-xl text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-300 transition';
      taskDescription.textContent = 'Whisper directly translates any audio into fluent English.';
    }
    if (window.lucide) lucide.createIcons();
  }

  temperatureSlider.addEventListener('input', (e) => {
